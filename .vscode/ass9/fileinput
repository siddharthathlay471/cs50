#include <stdio.h>

int main() {
    FILE *fp = fopen("abc.txt", "w");
    int i, roll, marks;
    char name[30];

    if (fp == NULL) {
        printf("File cannot be opened!\n");
        return 1;
    }

    for (i = 1; i <= 3; i++) {
        printf("Roll Name Marks: ");
        scanf("%d %29s %d", &roll, name, &marks);
        fprintf(fp, "%d %s %d\n", roll, name, marks);
    }

    fclose(fp);
    printf("Data successfully saved!\n");
    return 0;
}